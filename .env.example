# ========================================
# ARCHIVO DE CONFIGURACIÓN - EJEMPLO
# ========================================
# Renombra este archivo a .env y completa los valores

# ========================================
# BASE DE DATOS
# ========================================
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=rifapro
DB_PASSWORD=tu_contraseña_segura_aqui
DB_DATABASE=rifapro_db

# Opciones: mysql, postgresql, sqlite
# Si usas SQLite, solo necesitas: DB_DATABASE=./data/rifapro.db

# ========================================
# SERVIDOR
# ========================================
APP_PORT=3000
APP_HOST=localhost
APP_ENV=development

# Valores válidos: development, production, staging
# En production: APP_ENV=production

# ========================================
# SEGURIDAD
# ========================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_jwt_secret_muy_largo_y_seguro_aqui_cambia_en_produccion

# Número de rondas de hash para contraseñas (10 es estándar)
SALT_ROUNDS=10

# Token expiration (en horas)
TOKEN_EXPIRY=24

# ========================================
# EMAIL (OPCIONAL)
# ========================================
# Para enviar notificaciones y confirmaciones

MAIL_SERVICE=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_email@gmail.com
MAIL_PASSWORD=tu_contraseña_app_aqui
MAIL_FROM=noreply@rifapro.com

# Nota: Para Gmail, usar "contraseña de aplicación", no la contraseña normal

# ========================================
# STRIPE / PAGOS (OPCIONAL)
# ========================================
STRIPE_PUBLIC_KEY=pk_test_tuclavePublicaDeStripe
STRIPE_SECRET_KEY=sk_test_tuclaveSecretaDeStripe

# ========================================
# AWS / ALMACENAMIENTO DE ARCHIVOS (OPCIONAL)
# ========================================
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=rifapro-uploads

# ========================================
# ANÁLITICA (OPCIONAL)
# ========================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
SENTRY_DSN=https://key@sentry.io/1234567

# ========================================
# DESARROLLO
# ========================================
APP_DEBUG=false
LOG_LEVEL=info

# Valores: error, warn, info, debug, trace
# En producción: LOG_LEVEL=warn

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# CORS
# ========================================
CORS_ORIGIN=http://localhost:3000

# En producción:
# CORS_ORIGIN=https://tudominio.com

# ========================================
# ARCHIVO DE COOKIE
# ========================================
COOKIE_SECRET=tu_cookie_secret_muy_seguro_cambialo
COOKIE_MAX_AGE=86400000

# Max age en milisegundos (86400000 = 1 día)

# ========================================
# NOTAS IMPORTANTES
# ========================================
# 1. NUNCA commitear este archivo con valores reales a Git
# 2. Usar .gitignore para excluir .env
# 3. En producción, usar variables de entorno del servidor
# 4. Cambiar todos los valores por defecto
# 5. Mantener secretos fuera del control de versiones
# 6. Usar contraseñas fuertes (mín. 12 caracteres)
# 7. Regenerar JWT_SECRET y COOKIE_SECRET regularmente
